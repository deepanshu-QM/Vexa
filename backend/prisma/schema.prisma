// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String           @id                       @default(uuid())            //Primary Key 
  username           String
  password           String
  gender             Gender 
  channelname        String          @unique
  banner             String
  profilepicture     String
  subscribecount     Int              @default(0)
  description        String
  uploads            Uploads[]   
  likes              Likes[]   
  comment            Comments[]  
  subscriptions      Subscription[]   @relation("SubscriberSubscriptions") /* How many Channels Does user Subscribed */
  subscribedChannels Subscription[]   @relation("ChannelSubscriptions")    /* Who subscribed to the channel? */
  Commentlikes       CommentsLikes[]

}

enum Gender {
  male
  female
  other
}

model Uploads {
  id                 String           @id                       @default(uuid())
  videourl           String
  slug               String           @unique
  thumbnail          String
  title              String           @db.VarChar(100)              /* this will Limits charcters */
  description        String?
  userId             String                /* it means v1 or v2 belongs to which name of user.id */
  user               User            @relation(fields: [userId], references: [id])
  views              Int             @default(0)
  Status             Status          @default(PROCESSING)
  visibility         Visibility      @default(PUBLIC)
  createdAt          DateTime         @default(now())
  likes             Likes[]
  comment           Comments[]
}

enum Status {
  PROCESSING
  READY
  FAIL
}

enum Visibility {
  PUBLIC
  PRIVATE 
  UNLISTED
}
model Subscription  {
  id               String            @id                        @default(uuid())
  subcriberId     String
  subscriber       User             @relation("SubscriberSubscriptions", fields: [subcriberId], references: [id])
  channelId       String
  channel         User             @relation("ChannelSubscriptions", fields: [channelId], references: [id])
  createdAt      DateTime          @default(now())
   
  @@unique([subcriberId,channelId])

}

model Likes {                                                                             /*Likes on Uploded videos */
  id                 String           @id                       @default(uuid())
  userId             String
  user               User           @relation(fields: [userId] , references: [id])
  uploadId          String
  upload            Uploads        @relation(fields :[uploadId], references: [id])   

 @@unique([userId,uploadId])

}

model Comments {
  id                String           @id                        @default(uuid())
  content           String          @db.VarChar(1000)
  userId             String
  user               User           @relation(fields: [userId] , references: [id])
  uploadId          String
  upload            Uploads        @relation(fields :[uploadId], references: [id])   

  parentId          String?
  parent            Comments?       @relation( "Replies", fields: [parentId],references: [id])
  replies            Comments[]      @relation("Replies")

 likes              CommentsLikes[]  @relation("Likes on Comments")
 likesCount         Int              @default(0)

 createdAt          DateTime         @default(now())
 updatedAt          DateTime         @updatedAt
 @@index([userId,uploadId])

}
 
model CommentsLikes {                                                                 /* Likes on both uploded Video comments and comments Reply */
  id               String          @id                     @default(uuid())
  userId             String
  user               User           @relation(fields: [userId] , references: [id])

  commentId         String
  comment           Comments         @relation("Likes on Comments", fields: [commentId], references: [id])
  createdAt          DateTime       @default(now())

  @@unique([userId,commentId])

}